---
import Brand from './Brand.astro';

function socialUrl(value: string | undefined, allowedHosts: string[]): string | null {
  if (!value?.trim()) return null;
  try {
    const url = new URL(value.trim());
    if (url.protocol !== 'https:' || !allowedHosts.includes(url.hostname.toLowerCase())) return null;
    return url.href;
  } catch {
    return null;
  }
}

const links = [
  { name: 'Discord', url: socialUrl(import.meta.env.PUBLIC_DISCORD_URL, ['discord.com', 'discord.gg']), placeholder: 'PUBLIC_DISCORD_URL' },
  { name: 'Instagram', url: socialUrl(import.meta.env.PUBLIC_INSTAGRAM_URL, ['instagram.com', 'www.instagram.com']), placeholder: 'PUBLIC_INSTAGRAM_URL' },
  { name: 'GitHub', url: socialUrl(import.meta.env.PUBLIC_GITHUB_URL, ['github.com', 'www.github.com']), placeholder: 'PUBLIC_GITHUB_URL' },
];
---
<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-branding">
      <Brand />
      <span class="footer-copyright">© 2026 Anineko. All rights reserved.</span>
    </div>
    <div class="footer-right">
      <nav class="footer-legal" aria-label="Правна информация / Legal">
        <a href="/privacy/">Поверителност / Privacy</a>
        <a href="/dmca/">Авторски права / Copyright</a>
      </nav>
      <nav class="footer-social" aria-label="Социални мрежи / Social media">
        {links.map(({ name, url, placeholder }) => url ? (
          <a class="social-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={name} title={name}>
            {name === 'Discord' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.7 5.1a18.5 18.5 0 0 0-4.6-1.4l-.6 1.2a17 17 0 0 0-5 0l-.6-1.2a18.5 18.5 0 0 0-4.6 1.4C1.4 9.4.6 13.6 1 17.8a18.6 18.6 0 0 0 5.7 2.9l1.2-2a12 12 0 0 1-1.9-.9l.5-.4a13.3 13.3 0 0 0 11 0l.5.4a12 12 0 0 1-1.9.9l1.2 2a18.6 18.6 0 0 0 5.7-2.9c.5-4.9-.8-9-3.3-12.7ZM8.8 14.8c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"/></svg>}
            {name === 'Instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>}
            {name === 'GitHub' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.6v-2.1c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.4-5.5-6.1 0-1.4.5-2.5 1.2-3.4-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.7.3 3 .1 3.3.8.9 1.2 2 1.2 3.4 0 4.7-2.8 5.8-5.5 6.1.4.4.8 1 .8 2v3c0 .4.2.7.8.6A11.1 11.1 0 0 0 12 .9Z"/></svg>}
          </a>
        ) : (
          <span class="social-link social-unconfigured" role="img" aria-label={`${name} — official URL not configured`} title={`Configure ${placeholder}`}>
            {name === 'Discord' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.7 5.1a18.5 18.5 0 0 0-4.6-1.4l-.6 1.2a17 17 0 0 0-5 0l-.6-1.2a18.5 18.5 0 0 0-4.6 1.4C1.4 9.4.6 13.6 1 17.8a18.6 18.6 0 0 0 5.7 2.9l1.2-2a12 12 0 0 1-1.9-.9l.5-.4a13.3 13.3 0 0 0 11 0l.5.4a12 12 0 0 1-1.9.9l1.2 2a18.6 18.6 0 0 0 5.7-2.9c.5-4.9-.8-9-3.3-12.7ZM8.8 14.8c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"/></svg>}
            {name === 'Instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>}
            {name === 'GitHub' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.6v-2.1c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.4-5.5-6.1 0-1.4.5-2.5 1.2-3.4-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.7.3 3 .1 3.3.8.9 1.2 2 1.2 3.4 0 4.7-2.8 5.8-5.5 6.1.4.4.8 1 .8 2v3c0 .4.2.7.8.6A11.1 11.1 0 0 0 12 .9Z"/></svg>}
            <span class="social-name">{name}</span>
            <span class="social-config">link pending</span>
          </span>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 64px; border-top: 1px solid #ffffff14; background: #0c0d0b; color: var(--muted); }
  .footer-inner { display: flex; min-height: 92px; align-items: center; justify-content: space-between; gap: 18px 28px; padding-block: 18px; }
  .footer-branding, .footer-right { display: flex; align-items: center; gap: 18px; }
  .footer-branding { min-width: 0; flex-wrap: wrap; }
  .footer-branding :global(.brand) { font-size: .74rem; }
  .footer-branding :global(.brand-mark) { width: 30px; height: 30px; }
  .footer-copyright { font-size: .68rem; }
  .footer-right { justify-content: end; flex-wrap: wrap; }
  .footer-legal, .footer-social { display: flex; align-items: center; gap: 14px; }
  .footer-legal { font-size: .7rem; }
  .footer-legal a:hover, .social-link:hover { color: var(--accent-strong); }
  .social-link { display: inline-flex; align-items: center; gap: 5px; color: #c8c8bd; transition: color .16s ease; }
  .social-link svg { width: 19px; height: 19px; }
  .social-name { font-size: .68rem; }
  .social-config { font-size: .58rem; color: #77786e; }
  .social-unconfigured { cursor: help; }
  @media (max-width: 760px) {
    .footer-inner, .footer-right { align-items: flex-start; }
    .footer-inner { flex-direction: column; }
    .footer-right { width: 100%; justify-content: space-between; gap: 12px; }
    .footer-legal, .footer-social { gap: 10px; flex-wrap: wrap; }
  }
  @media (max-width: 420px) {
    .footer-right { flex-direction: column; }
    .social-config { display: none; }
  }
</style>
