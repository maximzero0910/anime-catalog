---
import '../styles/global.css';
import Player from '../components/Player.astro';
import Brand from '../components/Brand.astro';
---
<html lang="bg">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" href="/anineko-mark.svg" type="image/svg+xml"/><title>Гледай аниме — Anineko</title></head>
  <body>
    <header class="site-header"><div class="shell header-row"><Brand /><nav class="site-nav"><a href="/#catalog">Каталог</a><a href="/about">За проекта</a></nav></div></header>
    <main class="shell watch-main">
      <div class="watch-heading"><div><p class="eyebrow" data-provider-title>Доставчик</p><h1 data-provider-episode>Епизод</h1></div><a href="/">Към търсенето</a></div>
      <Player slug="provider" ep={1} anilistId={0} title="Аниме от доставчик" stream="" provider="" providerEpisodeId={null} next={null} previous={null}/>
    </main>
  </body>
</html>
