---
import '../styles/global.css';
import TitleCard from '../components/TitleCard.astro';
import Search from '../components/Search.astro';
import { getTitles } from '../lib/db';
import { readFile } from 'node:fs/promises';
const titles = getTitles().slice(0, 30);
const featured = titles[0];
const descriptions = JSON.parse(await readFile(new URL('../../data/descriptions.json', import.meta.url), 'utf8').catch(() => '{}')) as Record<string, string | null>;
const featuredTitle = featured?.title_bg ?? featured?.english ?? featured?.romaji ?? featured?.native ?? 'Аниме каталог';
const featuredDescription = featured ? (descriptions[String(featured.id)] ?? '') : '';
const genreSections = [
  { key: 'romcom', title: 'Rom-com', kicker: 'РОМАНТИКА С КОМЕДИЯ', test: (title: typeof titles[number]) => title.genres.includes('Romance') && title.genres.includes('Comedy') },
  { key: 'shonen', title: 'Шонен', kicker: 'ДЕМОГРАФСКА КАТЕГОРИЯ', test: (title: typeof titles[number]) => title.tags.some(tag => tag.toLowerCase() === 'shounen') },
  { key: 'fantasy', title: 'Фентъзи приключения', kicker: 'МАГИЯ И ДРУГИ СВЕТОВЕ', test: (title: typeof titles[number]) => title.genres.includes('Fantasy') },
  { key: 'scifi', title: 'Научна фантастика', kicker: 'БЪДЕЩЕ И ТЕХНОЛОГИИ', test: (title: typeof titles[number]) => title.genres.includes('Sci-Fi') },
].map(section => ({ ...section, titles: titles.filter(section.test).slice(0, 10) })).filter(section => section.titles.length > 0);
---
<html lang="bg">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
    <meta name="description" content="Откривай аниме заглавия и налични български субтитри."/>
    <title>Аниме BG — открий аниме</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="/" aria-label="Аниме BG начало"><span class="brand-mark" aria-hidden="true">А</span><span>ANIME BG</span></a>
        <nav class="site-nav" aria-label="Основна навигация"><a href="#catalog">Каталог</a><a href="/about">За проекта</a></nav>
        <a class="nav-search" href="#search">ТЪРСИ <span aria-hidden="true">↘</span></a>
      </div>
    </header>
    <main class="shell home-main" data-pagefind-body>
      {featured && <section class="featured" style={featured.banner ? `background-image:url('${featured.banner}')` : featured.cover ? `background-image:url('${featured.cover}')` : ''} aria-labelledby="featured-title">
        <div class="featured-content">
          <p class="eyebrow">ИЗБРАНО ОТ КАТАЛОГА</p>
          <h1 id="featured-title">{featuredTitle}</h1>
          {featuredDescription && <p class="featured-description">{featuredDescription.replace(/<[^>]*>/g, '').slice(0, 240)}{featuredDescription.length > 240 ? '…' : ''}</p>}
          <div class="meta-line"><span>{featured.year ?? 'Година неизвестна'}</span><span>{featured.format ?? 'Аниме'}</span>{featured.score && <span>★ {featured.score.toFixed(1)}</span>}</div>
          <a class="button-primary" href={`/anime/${featured.slug}`}><span>Разгледай заглавието</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </section>}
      <Search />
      {genreSections.map(section => <section class="genre-section" aria-labelledby={`genre-${section.key}`}>
        <div class="section-heading"><div><p class="section-kicker">{section.kicker}</p><h2 id={`genre-${section.key}`}>{section.title}</h2></div><a class="section-kicker" href="#catalog" data-select-filter={section.key}>Виж всички</a></div>
        <div class="genre-rail">{section.titles.map(title => <TitleCard title={title} />)}</div>
      </section>)}
      <section class="catalog-section" id="catalog" aria-labelledby="catalog-title">
        <div class="section-heading"><div><p class="section-kicker">ЗАГЛАВИЯ ОТ ANIList</p><h2 id="catalog-title">Каталог</h2></div><span class="section-kicker">{titles.length} заглавия</span></div>
        <div class="catalog-filters" role="group" aria-label="Филтрирай каталога по жанр">
          <button type="button" class="catalog-filter is-active" data-catalog-filter="all" aria-pressed="true">Всички</button>
          <button type="button" class="catalog-filter" data-catalog-filter="romcom" aria-pressed="false">Rom-com</button>
          <button type="button" class="catalog-filter" data-catalog-filter="shonen" aria-pressed="false">Шонен</button>
          <button type="button" class="catalog-filter" data-catalog-filter="action" aria-pressed="false">Екшън</button>
          <button type="button" class="catalog-filter" data-catalog-filter="fantasy" aria-pressed="false">Фентъзи</button>
          <button type="button" class="catalog-filter" data-catalog-filter="scifi" aria-pressed="false">Sci-Fi</button>
          <button type="button" class="catalog-filter" data-catalog-filter="drama" aria-pressed="false">Драма</button>
          <span class="catalog-filter-count" data-filter-count aria-live="polite">{titles.length} заглавия</span>
        </div>
        <div class="grid catalog-grid" id="catalog-grid">{titles.map(title => <TitleCard title={title} />)}</div>
      </section>
    </main>
    <footer class="footer"><div class="shell"><a href="/about">За проекта</a> · <a href="/dmca">DMCA</a><span> · Български субтитри, когато са налични.</span></div></footer>
  </body>
  <script>
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-catalog-filter]')];
    const catalogCards = [...document.querySelectorAll<HTMLElement>('#catalog-grid [data-catalog-card]')];
    const count = document.querySelector<HTMLElement>('[data-filter-count]');
    const matches = (card: HTMLElement, filter: string) => {
      const genres = JSON.parse(card.dataset.genres ?? '[]') as string[];
      const tags = JSON.parse(card.dataset.tags ?? '[]') as string[];
      if (filter === 'romcom') return genres.includes('Romance') && genres.includes('Comedy');
      if (filter === 'shonen') return tags.some(tag => tag.toLowerCase() === 'shounen');
      if (filter === 'action') return genres.includes('Action');
      if (filter === 'fantasy') return genres.includes('Fantasy');
      if (filter === 'scifi') return genres.includes('Sci-Fi');
      if (filter === 'drama') return genres.includes('Drama');
      return true;
    };
    const selectFilter = (filter: string) => {
      let visible = 0;
      for (const card of catalogCards) {
        card.hidden = !matches(card, filter);
        if (!card.hidden) visible++;
      }
      for (const button of filterButtons) {
        const active = button.dataset.catalogFilter === filter;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      if (count) count.textContent = `${visible} заглавия`;
    };
    for (const button of filterButtons) button.addEventListener('click', () => selectFilter(button.dataset.catalogFilter ?? 'all'));
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-select-filter]')) link.addEventListener('click', () => selectFilter(link.dataset.selectFilter ?? 'all'));
  </script>
</html>
