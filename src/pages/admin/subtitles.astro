import '../../styles/global.css';
---
<html lang="bg">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Субтитри — Anime BG</title></head>
  <body>
    <header class="site-header"><div class="shell header-row"><a class="brand" href="/">ANIME BG</a><nav class="site-nav"><a href="/">Каталог</a><a href="/about">За проекта</a></nav></div></header>
    <main class="shell subtitle-admin">
      <p class="eyebrow">ЛОКАЛНА ОБРАБОТКА</p><h1>Български субтитри</h1>
      <p class="muted">Индексът и резултатите се пазят локално в SQLite. Отделни процеси: <code>npm run subtitles:index</code> за откриване и <code>npm run subtitles:worker -- --watch</code> за превод.</p>
      <div class="admin-auth"><label for="admin-token">Административен токен</label><input id="admin-token" type="password" autocomplete="current-password" placeholder="SUBTITLE_ADMIN_TOKEN"/><button id="save-token" type="button">Запази за тази сесия</button></div>
      <div class="admin-controls"><button data-action="enqueue">Добави пилот</button><label>Епизоди <input id="queue-cap" type="number" min="1" max="10000" value="3"/></label><label>Конкурентност <input id="concurrency" type="number" min="1" max="32" value="1"/></label><button data-action="set-concurrency">Обнови конкурентност</button><button data-action="pause">Пауза</button><button data-action="resume">Продължи</button><button data-action="stop">Спри плавно</button><button data-action="retry-failed">Повтори грешките</button></div>
      <p id="admin-message" role="status" aria-live="polite"></p>
      <section aria-labelledby="glossary-title"><h2 id="glossary-title">Речник за сериал</h2><div class="admin-controls"><label>Аниме<select id="glossary-anime"><option value="">Избери сериал</option></select></label><label>Оригинален термин<input id="glossary-source" maxlength="200"/></label><label>Български превод<input id="glossary-target" maxlength="200"/></label><label>Бележка<input id="glossary-note" maxlength="500"/></label><button data-action="save-glossary">Добави термин</button></div><ul id="glossary-entries"><li>Избери сериал, за да видиш речника.</li></ul></section>
      <section aria-labelledby="metrics-title"><h2 id="metrics-title">Състояние</h2><div id="metrics" class="subtitle-metrics" aria-live="polite"><p>Зареждане…</p></div></section>
      <section aria-labelledby="index-providers-title"><h2 id="index-providers-title">Индекс по източник</h2><div class="table-scroll"><table><thead><tr><th>Източник</th><th>Записи</th><th>Готови за пускане</th><th>Само каталог</th><th>Проверени</th></tr></thead><tbody id="index-providers"><tr><td colspan="5">Зареждане…</td></tr></tbody></table></div></section>
      <section aria-labelledby="index-review-title"><h2 id="index-review-title">Проверка на субтитри</h2><div class="table-scroll"><table><thead><tr><th>Аниме / епизод</th><th>Източник</th><th>Оценка</th><th>Причина</th><th>Действия</th></tr></thead><tbody id="index-review"><tr><td colspan="5">Няма кандидати.</td></tr></tbody></table></div></section>
      <section aria-labelledby="jobs-title"><h2 id="jobs-title">Последни задачи</h2><div class="table-scroll"><table><thead><tr><th>Аниме / епизод</th><th>Състояние</th><th>Опити</th><th>Последна промяна</th><th>Действия</th></tr></thead><tbody id="jobs"><tr><td colspan="5">Зареждане…</td></tr></tbody></table></div></section>
      <section aria-labelledby="dead-title"><h2 id="dead-title">Мъртва опашка</h2><ul id="dead-letters"><li>Няма данни.</li></ul></section>
      <p id="models" class="muted"></p>
    </main>
    <style>
      .subtitle-admin{padding-block:3rem 5rem}.subtitle-admin h1{margin:.2rem 0 1rem}.subtitle-admin section{margin-top:2rem}.subtitle-admin h2{font-size:1.2rem}.admin-auth,.admin-controls{display:flex;align-items:end;gap:.7rem;flex-wrap:wrap;margin:1.25rem 0}.admin-auth label,.admin-controls label{display:grid;gap:.3rem;color:var(--muted,#9ca3af);font-size:.85rem}.subtitle-admin input,.subtitle-admin button{min-height:2.5rem;border:1px solid #38404e;border-radius:.55rem;background:#121722;color:inherit;padding:.45rem .75rem}.subtitle-admin button{cursor:pointer;background:#202938;transition:background .18s,border-color .18s}.subtitle-admin button:hover{background:#2b394d;border-color:#77849a}.subtitle-admin button:focus-visible,.subtitle-admin input:focus-visible{outline:2px solid #f1c75b;outline-offset:2px}.subtitle-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.7rem}.metric{padding:1rem;border:1px solid #2a3341;border-radius:.7rem;background:#10151e}.metric strong{display:block;font-size:1.35rem}.metric span{color:var(--muted,#9ca3af);font-size:.85rem}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:630px}th,td{text-align:left;padding:.7rem;border-bottom:1px solid #29313e}th{color:#aab4c4;font-size:.8rem}td button{margin-right:.35rem}.subtitle-admin code{color:#f1c75b}@media(max-width:600px){.subtitle-admin{padding-top:2rem}.admin-auth>*{width:100%}.admin-controls button,.admin-controls label{flex:1 1 42%}}
    </style>
    <script>
      interface AdminData { eligibleEpisodes:number; alreadyBulgarian:number; awaiting:number; inFlight:number; completed:number; failed:number; skipped:number; meanTranslationSeconds:number|null; throughputPerHour:number; activeTranslatedCues:number; activeCuesPerHour:number|null; activeEpisodeRemainingSeconds:number|null; estimatedRemainingSeconds:number|null; worker:string; workerControl:string; concurrency:number; activeModel:string|null; subtitleIndex:{titles:number;entries:number;assets:number;playableRows:number;catalogOnlyRows:number;verifiedRows:number;verificationQueued:number;providers:number;queued:number;running:number;completed:number;failed:number}; subtitleIndexProviders:Array<{provider:string;indexedRows:number;playableRows:number;catalogOnlyRows:number;verifiedRows:number}>; subtitleIndexReview:Array<Record<string,unknown>>; models:Array<{name:string;backend:string;languages?:{en:boolean;ja:boolean}}> ; resources:{cpuCount:number;loadAverage:number[];memoryUsedPercent:number;gpu:{name:string;vramTotalMiB:number;vramUsedMiB:number;utilizationPercent:number}|null}; jobs:Array<Record<string,unknown>>; deadLetters:Array<Record<string,unknown>>; adminControlsEnabled:boolean; titles:Array<{id:number;name:string}>; glossary:Array<{source:string;target:string;note:string}>; }
      const tokenInput=document.querySelector<HTMLInputElement>('#admin-token')!;
      tokenInput.value=sessionStorage.getItem('subtitle-admin-token')??'';
      document.querySelector('#save-token')?.addEventListener('click',()=>{sessionStorage.setItem('subtitle-admin-token',tokenInput.value);message('Токенът се пази до затваряне на тази сесия.');});
      const message=(value:string)=>{document.querySelector<HTMLElement>('#admin-message')!.textContent=value;};
      const fmt=(value:unknown)=>typeof value==='number'?new Intl.NumberFormat('bg-BG',{maximumFractionDigits:1}).format(value):'—';
      const escapeText=(value:unknown)=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]!));
      async function refresh(){
        try{
          const animeId=document.querySelector<HTMLSelectElement>('#glossary-anime')!.value;
          const response=await fetch(`/api/subtitles/admin${animeId?`?animeId=${encodeURIComponent(animeId)}`:''}`,{cache:'no-store'});if(!response.ok)throw new Error(`HTTP ${response.status}`);const data=await response.json() as AdminData;
          const animeSelect=document.querySelector<HTMLSelectElement>('#glossary-anime')!;
          if(animeSelect.options.length<=1)animeSelect.insertAdjacentHTML('beforeend',data.titles.map(title=>`<option value="${title.id}">${escapeText(title.name)} (${title.id})</option>`).join(''));
          const cards:[string,unknown][]=[['Каталог',data.eligibleEpisodes],['Български',data.alreadyBulgarian],['В опашката',data.awaiting],['В обработка',data.inFlight],['Завършени',data.completed],['Неуспешни',data.failed],['Пропуснати',data.skipped],['Епизода/час',data.throughputPerHour],['Куи/час (активно)',data.activeCuesPerHour],['Преведени куи (активно)',data.activeTranslatedCues],['Текущ епизод оставащи (часа)',data.activeEpisodeRemainingSeconds===null?null:data.activeEpisodeRemainingSeconds/3600],['Средно време (сек.)',data.meanTranslationSeconds],['Оставащи часове',data.estimatedRemainingSeconds===null?null:data.estimatedRemainingSeconds/3600],['RAM използвана (%)',data.resources.memoryUsedPercent],['Worker процес',data.worker],['Worker контрол',data.workerControl],['Модел',data.activeModel??(data.models.map(model=>model.name).join(', ')||'недостъпен')]];
          cards.push(['Индекс: заглавия',data.subtitleIndex.titles],['Всички индексни записи',data.subtitleIndex.entries],['Готови за пускане',data.subtitleIndex.playableRows],['Само каталожни',data.subtitleIndex.catalogOnlyRows],['Проверени записи',data.subtitleIndex.verifiedRows],['Готови BG файла',data.subtitleIndex.assets],['За проверка',data.subtitleIndex.verificationQueued],['Индекс: чакащи',data.subtitleIndex.queued],['Индекс: в работа',data.subtitleIndex.running],['Индекс: грешки',data.subtitleIndex.failed]);
          document.querySelector('#index-providers')!.innerHTML=data.subtitleIndexProviders.map(item=>`<tr><td>${escapeText(item.provider)}</td><td>${fmt(item.indexedRows)}</td><td>${fmt(item.playableRows)}</td><td>${fmt(item.catalogOnlyRows)}</td><td>${fmt(item.verifiedRows)}</td></tr>`).join('')||'<tr><td colspan="5">Няма индексни записи.</td></tr>';
          document.querySelector('#index-review')!.innerHTML=data.subtitleIndexReview.map(item=>`<tr><td>${escapeText(`${item.english??item.romaji??`AniList ${item.anime_id}`} · ep ${item.episode_number}`)}</td><td>${escapeText(item.provider)}</td><td>${fmt(item.quality_score)}</td><td>${escapeText(item.reason)}</td><td><button data-index-action="verify-index" data-index="${escapeText(item.index_id)}">Потвърди</button><button data-index-action="reject-index" data-index="${escapeText(item.index_id)}">Отхвърли</button></td></tr>`).join('')||'<tr><td colspan="5">Няма кандидати за проверка.</td></tr>';
          if(data.resources.gpu)cards.push(['GPU',`${data.resources.gpu.name}: ${data.resources.gpu.utilizationPercent}% · ${data.resources.gpu.vramUsedMiB}/${data.resources.gpu.vramTotalMiB} MiB`]);
          document.querySelector('#metrics')!.innerHTML=cards.map(([label,value])=>`<div class="metric"><strong>${escapeText(fmt(value))}</strong><span>${escapeText(label)}</span></div>`).join('');
          document.querySelector<HTMLInputElement>('#concurrency')!.value=String(data.concurrency);
          document.querySelector('#jobs')!.innerHTML=data.jobs.map(job=>`<tr><td>${escapeText(`${job.english??job.romaji??`AniList ${job.anime_id}`} · ep ${job.episode_id}`)}</td><td>${escapeText(job.status)}</td><td>${escapeText(job.attempts)}</td><td>${escapeText(job.updated_at)}</td><td>${job.status==='COMPLETED'?`<a href="/api/subtitles/${encodeURIComponent(String(job.anime_id))}/${encodeURIComponent(String(job.episode_id))}" target="_blank" rel="noreferrer">Провери VTT</a>`:''}<button data-job="${escapeText(job.id)}" data-job-action="retry">Повтори</button><button data-job="${escapeText(job.id)}" data-job-action="skip">Пропусни</button></td></tr>`).join('')||'<tr><td colspan="5">Опашката е празна.</td></tr>';
          document.querySelector('#dead-letters')!.innerHTML=data.deadLetters.map(item=>`<li>Задача ${escapeText(item.job_id)} · ${escapeText(item.reason)}</li>`).join('')||'<li>Няма грешки.</li>';
          document.querySelector('#glossary-entries')!.innerHTML=data.glossary.map(entry=>`<li><strong>${escapeText(entry.source)}</strong> → ${escapeText(entry.target)}${entry.note?` · ${escapeText(entry.note)}`:''}</li>`).join('')||'<li>Няма запазени термини.</li>';
          document.querySelector('#models')!.textContent=`Модели: ${data.models.map(model=>`${model.name} (${model.backend}${model.languages?`, EN ${model.languages.en?'✓':'✗'}, JA ${model.languages.ja?'✓':'✗'}`:''})`).join(', ')||'няма локален модел'}. CPU нишки: ${data.resources.cpuCount}; системен товар: ${data.resources.loadAverage.map(fmt).join(' / ')}.`;
        }catch(error){message(`Неуспешно обновяване: ${error instanceof Error?error.message:String(error)}`);}
      }
      async function action(body:Record<string,unknown>){
        const token=sessionStorage.getItem('subtitle-admin-token')??'';const headers:Record<string,string>={'content-type':'application/json'};if(token)headers.authorization=`Bearer ${token}`;
        try{const response=await fetch('/api/subtitles/admin',{method:'POST',headers,body:JSON.stringify(body)});const result=await response.json();if(!response.ok)throw new Error(result.error??`HTTP ${response.status}`);message('Промяната е записана.');await refresh();}catch(error){message(error instanceof Error?error.message:String(error));}
      }
      document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button=>button.addEventListener('click',()=>{
        const kind=button.dataset.action!;if(kind==='enqueue'){void action({action:'enqueue',cap:Number(document.querySelector<HTMLInputElement>('#queue-cap')!.value)});return;}
        if(kind==='set-concurrency'){void action({action:'concurrency',value:Number(document.querySelector<HTMLInputElement>('#concurrency')!.value)});return;}
        if(kind==='save-glossary'){const animeId=Number(document.querySelector<HTMLSelectElement>('#glossary-anime')!.value);const source=document.querySelector<HTMLInputElement>('#glossary-source')!.value.trim();const target=document.querySelector<HTMLInputElement>('#glossary-target')!.value.trim();const note=document.querySelector<HTMLInputElement>('#glossary-note')!.value.trim();if(!animeId||!source||!target){message('Изберете сериал и попълнете оригиналния термин и превода.');return;}void action({action:'glossary',animeId,entries:[{source,target,note}]});return;}
        void action({action:kind});
      }));
      document.querySelector('#jobs')!.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-job-action]');if(button)void action({action:button.dataset.jobAction,id:Number(button.dataset.job)});});
      document.querySelector('#index-review')!.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-index-action]');if(!button)return;const evidence=window.prompt('Посочете проверените данни: заглавие/епизод, cue timing или cut duration.');if(!evidence||evidence.trim().length<8)return;void action({action:button.dataset.indexAction,indexId:Number(button.dataset.index),evidence:evidence.trim()});});
      document.querySelector<HTMLSelectElement>('#glossary-anime')!.addEventListener('change',()=>void refresh());
      void refresh();window.setInterval(()=>void refresh(),10000);
    </script>
  </body>
</html>
