---
import '../../styles/global.css';
import Brand from '../../components/Brand.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<html lang="bg"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" href="/anineko-mark.svg" type="image/svg+xml"/><meta name="robots" content="noindex,nofollow"/><title>Telegram — Anineko</title></head><body>
<header class="site-header"><div class="shell header-row"><Brand /><nav class="site-nav"><a href="/">Каталог</a><a href="/admin/subtitles">Субтитри</a></nav></div></header>
<main class="shell admin"><p class="eyebrow">ИЗТОЧНИЦИ НА ЕПИЗОДИ</p><h1>Telegram синхронизация</h1><p class="muted">GramJS чете конфигурирания канал. Синхронизацията се изпълнява от отделния worker: <code>npm run telegram:sync -- --watch</code>. Видеофайловете се стриймват директно от Telegram; те не се копират.</p>
<div class="auth"><label for="token">Административен токен</label><input id="token" type="password" placeholder="TELEGRAM_ADMIN_TOKEN"/><button id="save-token">Запази за сесията</button><button id="sync">Синхронизирай сега</button></div><p id="message" role="status" aria-live="polite"></p>
<section><h2>Канал и прогрес</h2><div id="status" class="cards"><p>Зареждане…</p></div></section>
<section><h2>Публикации и асоциации</h2><div class="table"><table><thead><tr><th>Публикация</th><th>Състояние</th><th>Кандидати</th><th>Ръчна асоциация</th></tr></thead><tbody id="rows"><tr><td colspan="4">Зареждане…</td></tr></tbody></table></div></section>
<section><h2>Алтернативно заглавие</h2><div class="form"><select id="alias-anime"><option value="">Избери аниме</option></select><input id="alias" maxlength="200" placeholder="Заглавие, използвано в Telegram"/><button id="save-alias">Добави име</button></div></section>
</main>
<style>
.admin{padding-block:3rem 5rem}.admin section{margin-top:2rem}.admin h1{margin:.25rem 0 1rem}.auth,.form{display:flex;align-items:end;gap:.7rem;flex-wrap:wrap;margin:1.2rem 0}.auth label{display:grid;gap:.35rem}.admin input,.admin select,.admin button{min-height:2.5rem;border:1px solid #38404e;border-radius:.55rem;background:#121722;color:inherit;padding:.45rem .7rem}.admin button{cursor:pointer;background:#202938}.admin button:hover{background:#2b394d}.admin button:focus-visible,.admin input:focus-visible,.admin select:focus-visible{outline:2px solid #f1c75b;outline-offset:2px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.7rem}.card{padding:.9rem;border:1px solid #2a3341;border-radius:.7rem;background:#10151e}.card strong{display:block;font-size:1.1rem;overflow-wrap:anywhere}.card span{color:#9ca3af;font-size:.84rem}.table{overflow:auto}table{width:100%;min-width:950px;border-collapse:collapse}td,th{text-align:left;vertical-align:top;padding:.7rem;border-bottom:1px solid #29313e}td textarea{min-width:230px;min-height:3.5rem;background:#121722;color:inherit;border:1px solid #38404e;border-radius:.4rem;padding:.5rem}.assoc{display:flex;gap:.4rem;flex-wrap:wrap}.assoc select{max-width:230px}.assoc input{width:70px}.admin code{color:#f1c75b}@media(max-width:650px){.admin{padding-top:2rem}.auth>*{width:100%}}
</style>
<script>
interface TRow{channel_id:string;message_id:number;caption:string;filename:string;duration_seconds:number|null;file_size:number;anime_id:number|null;episode_number:number|null;season_number:number|null;confidence:number;status:string;reason:string;candidates:string;verified:number;primary_match:number;media_failure_count?:number;media_last_error?:string|null}
interface Data{status:Record<string,unknown>;mediaPool:{size:number;active:number;waiting:number;closed:boolean};messages:TRow[];titles:Array<{id:number;name:string}>}
const token=document.querySelector<HTMLInputElement>('#token')!;token.value=sessionStorage.getItem('telegram-admin-token')??'';
const note=(text:string)=>document.querySelector<HTMLElement>('#message')!.textContent=text;
const esc=(value:unknown)=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
async function call(body?:Record<string,unknown>){const headers:Record<string,string>={};const saved=sessionStorage.getItem('telegram-admin-token')??'';if(saved)headers.authorization=`Bearer ${saved}`;if(body)headers['content-type']='application/json';const response=await fetch('/api/telegram/admin',{method:body?'POST':'GET',headers,...(body?{body:JSON.stringify(body)}:{}),cache:'no-store'});const data=await response.json();if(!response.ok)throw new Error(data.error??`HTTP ${response.status}`);return data as Data;}
async function refresh(){try{const data=await call();const s=data.status;const fields:[string,unknown][]=[['Връзка',s.connectionConfigured?'Настройки зададени':'Няма настройки'],['Канал',s.channel_name||s.channel||'—'],['ID',s.channel_id||'—'],['Състояние',s.status],['Прогрес',s.progress],['Поточни клиенти',`${data.mediaPool.active}/${data.mediaPool.size} · опашка ${data.mediaPool.waiting}${data.mediaPool.closed?' · спрян':''}`],['Открити',s.discovered],['Съпоставени',s.matched],['Несъпоставени',s.unmatched],['Нееднозначни',s.ambiguous],['Дубликати',s.duplicates],['Счупени файлови препратки',s.failedMediaReferences],['Последна синхронизация',s.last_success],['Последна грешка',s.last_error]];document.querySelector('#status')!.innerHTML=fields.map(([name,value])=>`<div class="card"><strong>${esc(value??'—')}</strong><span>${esc(name)}</span></div>`).join('');
const select=(id:string)=>`<select data-anime><option value="">Избери аниме</option>${data.titles.map(title=>`<option value="${title.id}" ${Number(id)===title.id?'selected':''}>${esc(title.name)} · ${title.id}</option>`).join('')}</select>`;
document.querySelector('#rows')!.innerHTML=data.messages.map(row=>{let candidates:unknown[]=[];try{candidates=JSON.parse(row.candidates)||[]}catch{};return `<tr><td><strong>#${row.message_id} · ${esc(row.filename||'без име')}</strong><br>${esc(row.caption)}<br><small>${esc(row.duration_seconds??'—')} s · ${esc(row.file_size)} bytes${row.media_failure_count?` · media errors ${row.media_failure_count}: ${esc(row.media_last_error)}`:''}</small></td><td>${esc(row.status)} · ${Math.round(row.confidence*100)}%<br>${esc(row.reason)}</td><td>${candidates.map((item:any)=>`${esc(item.title)} (${esc(item.score)})`).join('<br>')||'—'}</td><td><div class="assoc">${select(String(row.anime_id??''))}<input data-episode type="number" min="1" value="${row.episode_number??''}" aria-label="Епизод"/><input data-season type="number" min="1" placeholder="S" value="${row.season_number??''}" aria-label="Сезон"/><button data-associate="${row.message_id}" data-channel="${esc(row.channel_id)}">Потвърди</button><button data-reject="${row.message_id}" data-channel="${esc(row.channel_id)}">Отхвърли</button></div></td></tr>`}).join('')||'<tr><td colspan="4">Няма открити публикации.</td></tr>';
const aliasSelect=document.querySelector<HTMLSelectElement>('#alias-anime')!;if(aliasSelect.options.length<=1)aliasSelect.insertAdjacentHTML('beforeend',data.titles.map(item=>`<option value="${item.id}">${esc(item.name)}</option>`).join(''));
}catch(error){note(error instanceof Error?error.message:String(error));}}
document.querySelector('#save-token')!.addEventListener('click',()=>{sessionStorage.setItem('telegram-admin-token',token.value);note('Токенът е запазен до затваряне на сесията.');});
document.querySelector('#sync')!.addEventListener('click',async()=>{try{await call({action:'sync'});note('Синхронизацията е добавена в опашката.');await refresh();}catch(error){note(error instanceof Error?error.message:String(error));}});
document.querySelector('#rows')!.addEventListener('click',async event=>{const target=(event.target as HTMLElement).closest<HTMLButtonElement>('button');if(!target)return;try{if(target.dataset.associate){const row=target.closest('tr')!;await call({action:'associate',channelId:target.dataset.channel,messageId:Number(target.dataset.associate),animeId:Number(row.querySelector<HTMLSelectElement>('[data-anime]')!.value),episode:Number(row.querySelector<HTMLInputElement>('[data-episode]')!.value),season:row.querySelector<HTMLInputElement>('[data-season]')!.value||null});note('Асоциацията е потвърдена.');}else if(target.dataset.reject){await call({action:'reject',channelId:target.dataset.channel,messageId:Number(target.dataset.reject)});note('Кандидатът е отхвърлен.');}await refresh();}catch(error){note(error instanceof Error?error.message:String(error));}});
document.querySelector('#save-alias')!.addEventListener('click',async()=>{try{await call({action:'alias',animeId:Number(document.querySelector<HTMLSelectElement>('#alias-anime')!.value),alias:document.querySelector<HTMLInputElement>('#alias')!.value});note('Алтернативното име е запазено; повторната обработка става при следваща синхронизация.');await refresh();}catch(error){note(error instanceof Error?error.message:String(error));}});
void refresh();window.setInterval(()=>void refresh(),8000);
</script><SiteFooter/></body></html>
