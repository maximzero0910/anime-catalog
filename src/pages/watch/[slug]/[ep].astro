---
import '../../../styles/global.css';
import Player from '../../../components/Player.astro';
import { getAllWatchData } from '../../../lib/db';
import providerMapData from '../../../../data/provider-map.json';
export function getStaticPaths() {
  const providerMap = providerMapData as Record<string, { provider: string; episodes: Array<{ number: number; providerEpisodeId: string }> }>;
  const entries = getAllWatchData();
  return entries.map(item => {
    const group = entries.filter(candidate => candidate.id === item.id);
    const previous = group.find(candidate => candidate.number === item.number - 1);
    const next = group.find(candidate => candidate.number === item.number + 1);
    const title = item.title_bg ?? item.english ?? item.romaji ?? item.native ?? `Anime ${item.id}`;
    const mapping = providerMap[String(item.id)];
    const providerEpisodeId = mapping?.episodes.find(episode => episode.number === item.number)?.providerEpisodeId ?? null;
    return { params: { slug: item.slug, ep: String(item.number) }, props: { slug: item.slug, ep: item.number, title, subs: item.sub_path ? { path: item.sub_path, status: item.sub_status } : null, stream: providerEpisodeId ? `https://cdn.example.com/api/hls/${mapping.provider}/${encodeURIComponent(providerEpisodeId)}?slug=${encodeURIComponent(item.slug)}&ep=${item.number}` : '', provider: mapping?.provider ?? '', providerEpisodeId, item, previous: previous ? `/watch/${item.slug}/${previous.number}` : null, next: next ? `/watch/${item.slug}/${next.number}` : null } };
  });
}
const entries = getAllWatchData();
const { item, previous, next, stream, subs, provider, providerEpisodeId } = Astro.props;
const title = item.title_bg ?? item.english ?? item.romaji ?? item.native ?? `Anime ${item.id}`;
---
<html lang="bg"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} — Епизод {item.number}</title></head><body><header class="site-header"><div class="shell header-row"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">А</span><span>ANIME BG</span></a><nav class="site-nav"><a href={`/anime/${item.slug}`}>Заглавие</a><a href="/about">За проекта</a></nav><a class="nav-search" href="/#search">ТЪРСИ <span aria-hidden="true">↘</span></a></div></header><main class="shell watch-main"><div class="watch-heading"><div><p class="eyebrow">{title}</p><h1>Епизод {item.number}</h1></div><a href={`/anime/${item.slug}`}>Всички епизоди</a></div><Player slug={item.slug} ep={item.number} anilistId={item.id} title={title} stream={stream} provider={provider} providerEpisodeId={providerEpisodeId} next={next} previous={previous}/>{!subs && <p class="muted">Български субтитри все още не са налични за този епизод.</p>}{import.meta.env.DEV && <p class="fixture-note">Разрешени тестови медии за проверка на плеъра (не епизоди на доставчика): <a href={`/watch/${item.slug}/${item.number}?test=1`}>Mux HLS</a> · <a href={`/watch/${item.slug}/${item.number}?test=mp4`}>MDN CC0 MP4</a>.</p>}</main><footer class="footer"><div class="shell"><a href={`/anime/${item.slug}`}>Към заглавието</a> · <a href="/">Каталог</a></div></footer></body></html>
