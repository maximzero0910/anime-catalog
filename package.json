{
  "name": "anime-catalog-bg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build && pagefind --site dist",
    "preview": "astro preview",
    "ingest": "node --import tsx tools/ingest.ts",
    "build:index": "node --import tsx tools/build-index.ts",
    "provider:sync": "node --import tsx tools/sync-provider-map.ts",
    "test:e2e": "node --import tsx --test tools/e2e.test.ts",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "astro": "^5.0.0",
    "hls.js": "^1.5.17",
    "impit": "^0.14.9",
    "undici": "^8.12.4",
    "vidstack": "^1.12.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^13.2.0",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  }
}
