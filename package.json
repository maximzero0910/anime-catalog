{
  "name": "anime-catalog-bg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build && pagefind --site dist",
    "preview": "astro preview",
    "ingest": "node --import tsx tools/ingest.ts",
    "build:index": "node --import tsx tools/build-index.ts",
    "provider:sync": "node --import tsx tools/sync-provider-map.ts",
    "test:e2e": "node --import tsx --test tools/e2e.test.ts",
    "test:proxy": "node --import tsx --test src/lib/tests/hls-proxy.test.ts worker/tests/proxy.test.ts",
    "subtitles:worker": "node --import tsx tools/subtitles-worker.ts",
    "subtitles:index": "node --import tsx tools/subtitles-indexer.ts --watch",
    "subtitles:index:seed": "node --import tsx tools/subtitles-indexer.ts --seed",
    "telegram:sync": "node --import tsx tools/telegram-sync.ts --watch",
    "telegram:sync:once": "node --import tsx tools/telegram-sync.ts --once",
    "telegram:session": "node --import tsx tools/telegram-session.ts",
    "telegram:catalog-import": "node --import tsx tools/telegram-catalog-import.ts",
    "telegram:rematch": "node --import tsx tools/telegram-rematch.ts",
    "subtitles:test": "node --import tsx --test src/lib/subtitles/tests/*.test.ts",
    "subtitles:test:local": "node --import tsx --test src/lib/subtitles/tests/inference.test.ts",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "astro": "^7.4.12",
    "hls.js": "^1.5.17",
    "impit": "^0.14.9",
    "input": "^1.0.1",
    "ipaddr.js": "^2.5.0",
    "telegram": "^2.26.22",
    "undici": "^8.12.4",
    "vidstack": "^1.12.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^13.2.0",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
