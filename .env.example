# Server-only values. Never expose these with the PUBLIC_ prefix or bundle them into Pages.
CATALOG_DB_PATH=./data/catalog.db
SUBTITLE_DATA_DIR=./data/subtitles
SUBTITLE_ADMIN_TOKEN=replace-with-a-long-random-secret
TELEGRAM_ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Telegram account/channel access (server only)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL=

# Optional subtitle discovery provider
OPEN_SUBTITLES_API_KEY=

# Public URL used by server-generated links; configure separately from Pages build settings.
PAGES_URL=https://anineko.eu
WORKER_URL=

# Exact trusted media hosts and provider-owned rotating host zones, comma separated.
# Keep this narrow; entries beginning with *. match only subdomains of that suffix.
HLS_ALLOWED_HOSTS=fetch.nexabloom.top,*.twilightharbor.space,*.mysubsplay.com,megaplay.buzz,playtube.tv,saphiracdn.com,allanime.day,api.allanime.day,anikoto.cz,9anime.or.at,reanime.net

# Translation provider order and bounded worker configuration
SUBTITLE_PROVIDERS=translate-subtitles-com,translatesubtitles-co,syedgakbar,editsub,local
SUBTITLE_MAX_CONCURRENT_JOBS=1
SUBTITLE_MAX_BATCH_CUES=30
SUBTITLE_TIMEOUT_MS=60000

# Optional local inference. Leave unset to keep model work disabled.
SUBTITLE_INFERENCE_URL=
SUBTITLE_MODEL=
OLLAMA_HOST=

# Resolver configuration
RESOLVER=auto
CONSUMET_PROVIDER=
PLAYTUBE_PROVIDER_PRIORITY=1
TELEGRAM_PROVIDER_PRIORITY=1
