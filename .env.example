# Server-only values. Never expose these with the PUBLIC_ prefix or bundle them into Pages.
CATALOG_DB_PATH=./data/catalog.db
SUBTITLE_DATA_DIR=./data/subtitles
SUBTITLE_ADMIN_TOKEN=replace-with-a-long-random-secret
TELEGRAM_ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Telegram account/channel access (server only)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL=
TELEGRAM_OPERATION_TIMEOUT_MS=30000
TELEGRAM_MEDIA_CLIENTS=2
TELEGRAM_MEDIA_MAX_WAITING=4
TELEGRAM_MEDIA_WAIT_MS=3000

# Optional subtitle discovery provider
OPEN_SUBTITLES_API_KEY=

# Public URL used by server-generated links; configure separately from Pages build settings.
PAGES_URL=https://anineko.eu
WORKER_URL=

# Per-process API concurrency limits. Conservative defaults are also applied
# when values are omitted; values are clamped to code-defined safe ranges.
RESOURCE_GATE_WAIT_MS=3000
RESOURCE_PROVIDER_SEARCH_ACTIVE=8
RESOURCE_PROVIDER_SEARCH_WAITING=8
RESOURCE_PROVIDER_RESOLUTION_ACTIVE=4
RESOURCE_PROVIDER_RESOLUTION_WAITING=8
RESOURCE_METADATA_ACTIVE=4
RESOURCE_METADATA_WAITING=8
RESOURCE_CATALOG_FILTER_ACTIVE=2
RESOURCE_CATALOG_FILTER_WAITING=4

# Per-process API rate limits. Forwarded client IPs are used only when the
# socket peer is inside one of these explicitly trusted CIDRs. For the Pi's
# loopback Cloudflare Tunnel, configure only the exact loopback peer addresses.
REQUEST_RATE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Set the same random 32+ byte value as a server-only Pages Function secret.
ANINEKO_RATE_LIMIT_SIGNING_SECRET=replace-with-same-random-secret-in-pages-and-pi
REQUEST_RATE_GLOBAL_PER_MINUTE=1200
REQUEST_RATE_GENERAL_PER_MINUTE=240
REQUEST_RATE_SEARCH_PER_MINUTE=30
REQUEST_RATE_METADATA_PER_MINUTE=60
REQUEST_RATE_RESOLVE_PER_MINUTE=18
REQUEST_RATE_HLS_PER_MINUTE=900
REQUEST_RATE_ADMIN_PER_MINUTE=30

# Trusted HLS manifest origins, comma separated. Hosts referenced by a fetched
# manifest receive bounded, expiring proxy tokens and still undergo public-IP,
# DNS-pinning, redirect, timeout, and response-size validation.
HLS_ALLOWED_HOSTS=fetch.nexabloom.top,megaplay.buzz,playtube.tv,saphiracdn.com,allanime.day,api.allanime.day,anikoto.cz,9anime.or.at,reanime.net

# Translation provider order and bounded worker configuration
SUBTITLE_PROVIDERS=translate-subtitles-com,translatesubtitles-co,syedgakbar,editsub,local
SUBTITLE_MAX_CONCURRENT_JOBS=1
SUBTITLE_MAX_BATCH_CUES=30
SUBTITLE_TIMEOUT_MS=60000
SUBTITLE_STALE_LOCK_MS=120000
SUBTITLE_INDEX_STALE_LOCK_MS=120000
SUBTITLE_LOG_RETENTION_DAYS=180
SUBTITLE_LOG_MAX_ROWS=100000

# Optional local inference. Leave unset to keep model work disabled.
SUBTITLE_INFERENCE_URL=
SUBTITLE_MODEL=
OLLAMA_HOST=

# Resolver configuration
RESOLVER=auto
CONSUMET_PROVIDER=
PLAYTUBE_PROVIDER_PRIORITY=1
TELEGRAM_PROVIDER_PRIORITY=1
